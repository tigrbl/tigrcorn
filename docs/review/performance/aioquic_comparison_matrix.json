      "relative_regression_budget": {
        "max_p99_increase_fraction": 1.0,
        "max_throughput_drop_fraction": 0.75,
        "max_p99_9_increase_fraction": 1.0,
        "max_cpu_increase_fraction": 1.0,
        "max_rss_increase_fraction": 1.0,
        "absolute_p99_slack_ms": 2.0,
        "absolute_p99_9_slack_ms": 4.0,
        "absolute_cpu_slack_seconds": 0.05,
        "absolute_rss_slack_kib": 4096.0
      },
      "driver_config": {
        "backend": "tigrcorn",
        "host": "example.com",
        "path": "/interop",
        "body": "hello-http3-peer"
