    "certification_platforms": [
      "linux-x86_64-cpython3.11"
    ],
    "lane_definitions": {
      "component_regression": "same-stack backend comparison profiles"
    }
  },
  "profiles": [
    {
      "profile_id": "http3_prepare_tigrcorn",
      "family": "HTTP3",
      "description": "Tigrcorn HTTP/3 request preparation over the package-owned QUIC path.",
      "driver": "http3_peer_prepare",
      "deployment_profile": "http3_quic",
      "lane": "component_regression",
      "correctness_required": true,
      "hot_path": false,
      "iterations": 20,
      "warmups": 3,
      "units_per_iteration": 1,
      "thresholds": {
